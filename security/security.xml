<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        
        <!-- Categories -->
        <record id="module_category_general_agent" model="ir.module.category">
            <field name="name">General AI Agent</field>
            <field name="description">Manage AI agents and their operations</field>
            <field name="sequence">20</field>
        </record>
        
        <!-- Groups -->
        <record id="group_general_agent_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_general_agent"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
        
        <record id="group_general_agent_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_general_agent"/>
            <field name="implied_ids" eval="[(4, ref('group_general_agent_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
        
    </data>
</odoo>
