<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Agent Form View -->
    <record id="view_general_agent_form" model="ir.ui.view">
        <field name="name">general.agent.form</field>
        <field name="model">general.agent</field>
        <field name="arch" type="xml">
            <form string="AI Agent">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="idle,thinking,executing"/>
                    <button name="action_test_agent" string="Test Agent" type="object" class="oe_highlight"/>
                    <button name="action_reset_statistics" string="Reset Statistics" type="object" confirm="Are you sure you want to reset all statistics?"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_general_agent_task)d" type="action" class="oe_stat_button" icon="fa-tasks">
                            <field name="total_tasks_completed" widget="statinfo" string="Completed"/>
                        </button>
                        <button name="%(action_general_agent_task)d" type="action" class="oe_stat_button" icon="fa-exclamation-triangle">
                            <field name="total_tasks_failed" widget="statinfo" string="Failed"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="e.g., Customer Service Agent"/></h1>
                    </div>
                    <group>
                        <group name="configuration">
                            <field name="active"/>
                            <field name="default_llm"/>
                            <field name="temperature"/>
                            <field name="max_iterations"/>
                            <field name="max_tokens"/>
                            <field name="config_id"/>
                        </group>
                        <group name="statistics">
                            <field name="success_rate" widget="progressbar"/>
                            <field name="average_execution_time"/>
                            <field name="last_execution_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="System Prompt" name="system_prompt">
                            <field name="system_prompt" widget="text" placeholder="Enter the system prompt that defines the agent's behavior..."/>
                        </page>
                        <page string="Current Execution" name="execution">
                            <group>
                                <field name="current_task" readonly="1"/>
                                <field name="last_result" readonly="1"/>
                            </group>
                        </page>
                        <page string="Tasks" name="tasks">
                            <field name="task_ids">
                                <tree>
                                    <field name="create_date"/>
                                    <field name="name"/>
                                    <field name="state"/>
                                    <field name="priority"/>
                                    <field name="execution_time"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    
    <!-- Agent Tree View -->
    <record id="view_general_agent_tree" model="ir.ui.view">
        <field name="name">general.agent.tree</field>
        <field name="model">general.agent</field>
        <field name="arch" type="xml">
            <tree string="AI Agents">
                <field name="name"/>
                <field name="state" decoration-success="state=='idle'" decoration-info="state in ['thinking','executing']" decoration-danger="state=='error'"/>
                <field name="default_llm"/>
                <field name="total_tasks_completed"/>
                <field name="total_tasks_failed"/>
                <field name="success_rate" widget="progressbar"/>
                <field name="active"/>
            </tree>
        </field>
    </record>
    
    <!-- Agent Kanban View -->
    <record id="view_general_agent_kanban" model="ir.ui.view">
        <field name="name">general.agent.kanban</field>
        <field name="model">general.agent</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="state"/>
                <field name="default_llm"/>
                <field name="total_tasks_completed"/>
                <field name="success_rate"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title"><field name="name"/></strong>
                                </div>
                                <span class="float-end badge badge-pill" t-att-class="record.state.raw_value == 'idle' ? 'badge-success' : record.state.raw_value == 'error' ? 'badge-danger' : 'badge-info'">
                                    <field name="state"/>
                                </span>
                            </div>
                            <div class="o_kanban_record_body">
                                <field name="default_llm"/> | <field name="total_tasks_completed"/> tasks
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <field name="success_rate" widget="progressbar"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    
    <!-- Agent Search View -->
    <record id="view_general_agent_search" model="ir.ui.view">
        <field name="name">general.agent.search</field>
        <field name="model">general.agent</field>
        <field name="arch" type="xml">
            <search string="AI Agents">
                <field name="name"/>
                <field name="default_llm"/>
                <filter string="Active" name="active" domain="[('active','=',True)]"/>
                <filter string="Idle" name="idle" domain="[('state','=','idle')]"/>
                <filter string="Working" name="working" domain="[('state','in',['thinking','executing'])]"/>
                <filter string="Error" name="error" domain="[('state','=','error')]"/>
                <group expand="0" string="Group By">
                    <filter string="State" name="group_state" context="{'group_by':'state'}"/>
                    <filter string="LLM" name="group_llm" context="{'group_by':'default_llm'}"/>
                </group>
            </search>
        </field>
    </record>
    
    <!-- Agent Action -->
    <record id="action_general_agent" model="ir.actions.act_window">
        <field name="name">AI Agents</field>
        <field name="res_model">general.agent</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first AI Agent
            </p>
            <p>
                AI Agents can autonomously manage your business operations,
                from customer service to sales and project management.
            </p>
        </field>
    </record>
    
</odoo>
