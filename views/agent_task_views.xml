<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Task Form View -->
    <record id="view_general_agent_task_form" model="ir.ui.view">
        <field name="name">general.agent.task.form</field>
        <field name="model">general.agent.task</field>
        <field name="arch" type="xml">
            <form string="Agent Task">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="queued,processing,completed"/>
                    <button name="action_execute_now" string="Execute Now" type="object" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'queued')]}"/>
                    <button name="action_retry" string="Retry" type="object" attrs="{'invisible': [('state', '!=', 'failed')]}"/>
                    <button name="action_cancel" string="Cancel" type="object" attrs="{'invisible': [('state', 'not in', ['queued', 'processing'])]}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="agent_id"/>
                            <field name="priority"/>
                            <field name="session_id"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="execution_time"/>
                            <field name="retry_count"/>
                            <field name="max_retries"/>
                        </group>
                    </group>
                    <group>
                        <field name="task" widget="text" placeholder="Describe the task..."/>
                    </group>
                    <group string="Result" attrs="{'invisible': [('result', '=', False)]}">
                        <field name="result" widget="text" readonly="1"/>
                    </group>
                    <group>
                        <group>
                            <field name="create_date"/>
                            <field name="start_date"/>
                        </group>
                        <group>
                            <field name="complete_date"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    
    <!-- Task Tree View -->
    <record id="view_general_agent_task_tree" model="ir.ui.view">
        <field name="name">general.agent.task.tree</field>
        <field name="model">general.agent.task</field>
        <field name="arch" type="xml">
            <tree string="Agent Tasks" decoration-success="state=='completed'" decoration-danger="state=='failed'" decoration-muted="state=='cancelled'">
                <field name="create_date"/>
                <field name="name"/>
                <field name="agent_id"/>
                <field name="priority"/>
                <field name="state"/>
                <field name="execution_time" optional="hide"/>
                <field name="user_id" optional="hide"/>
            </tree>
        </field>
    </record>
    
    <!-- Task Kanban View -->
    <record id="view_general_agent_task_kanban" model="ir.ui.view">
        <field name="name">general.agent.task.kanban</field>
        <field name="model">general.agent.task</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="agent_id"/>
                <field name="priority"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title"><field name="name"/></strong>
                                </div>
                                <span class="float-end badge badge-pill" t-att-class="record.priority.raw_value == '10' ? 'badge-danger' : record.priority.raw_value == '8' ? 'badge-warning' : 'badge-secondary'">
                                    <field name="priority"/>
                                </span>
                            </div>
                            <div class="o_kanban_record_body">
                                <field name="agent_id"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    
    <!-- Task Search View -->
    <record id="view_general_agent_task_search" model="ir.ui.view">
        <field name="name">general.agent.task.search</field>
        <field name="model">general.agent.task</field>
        <field name="arch" type="xml">
            <search string="Agent Tasks">
                <field name="name"/>
                <field name="agent_id"/>
                <field name="session_id"/>
                <filter string="Queued" name="queued" domain="[('state','=','queued')]"/>
                <filter string="Processing" name="processing" domain="[('state','=','processing')]"/>
                <filter string="Completed" name="completed" domain="[('state','=','completed')]"/>
                <filter string="Failed" name="failed" domain="[('state','=','failed')]"/>
                <filter string="High Priority" name="high_priority" domain="[('priority','in',['8','10'])]"/>
                <group expand="0" string="Group By">
                    <filter string="Agent" name="group_agent" context="{'group_by':'agent_id'}"/>
                    <filter string="State" name="group_state" context="{'group_by':'state'}"/>
                    <filter string="Priority" name="group_priority" context="{'group_by':'priority'}"/>
                    <filter string="Session" name="group_session" context="{'group_by':'session_id'}"/>
                </group>
            </search>
        </field>
    </record>
    
    <!-- Task Action -->
    <record id="action_general_agent_task" model="ir.actions.act_window">
        <field name="name">Agent Tasks</field>
        <field name="res_model">general.agent.task</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'search_default_queued': 1, 'search_default_processing': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No tasks yet
            </p>
            <p>
                Tasks will appear here when you queue them for your AI agents.
            </p>
        </field>
    </record>
    
</odoo>
